# Admin panel password (server-only, never expose as NEXT_PUBLIC_)
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yaz

# OneDrive (Microsoft Graph) — fotoğraf ve ürün kaydı
# Azure Portal → App registrations → New registration
# Redirect URI: http://localhost:3456/callback (Web)
# API permission: Microsoft Graph → Delegated → Files.ReadWrite
# Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Token almak için: npm run onedrive:auth
MICROSOFT_REFRESH_TOKEN=
# OneDrive kök klasör adı (otomatik oluşturulur)
ONEDRIVE_FOLDER=DNZ-Site
